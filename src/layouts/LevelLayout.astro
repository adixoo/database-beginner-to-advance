---
import Footer from '../components/Footer.astro';
import Navbar from '../components/Navbar.astro';
import TopicsSidebar from '../components/TopicsSidebar.astro';
import { SITE_NAME, type Level } from '../config/site';
import type { JsonLd } from '../lib/seo';
import Layout from './Layout.astro';

interface Props {
	level: Level;
	title: string;
	description: string;
	// Topic id to mark as current in the sidebar
	currentTopic?: string;
	type?: 'website' | 'article';
	jsonLd?: readonly JsonLd[];
}

const { level, title, description, currentTopic, type, jsonLd } = Astro.props;
---

<Layout title={`${title} · ${SITE_NAME}`} description={description} type={type} jsonLd={jsonLd}>
	<div id="top" class="flex flex-col lg:min-h-svh">
		<Navbar current={level} />
		<div
			class="grid flex-1 items-start gap-10 px-page pt-12 pb-24 lg:grid-cols-[minmax(240px,320px)_1fr] lg:gap-16 lg:pt-20"
		>
			<main class="min-w-0 lg:col-start-2 lg:row-start-1">
				<slot />
			</main>
			<!-- On a topic page, phones get the TopicsMenu at the top instead of this list at the end -->
			<TopicsSidebar
				level={level}
				currentTopic={currentTopic}
				class:list={[
					'scrollbar-on-hover max-lg:-mx-3 lg:sticky lg:top-8 lg:col-start-1 lg:row-start-1 lg:block lg:max-h-[calc(100svh-4rem)] lg:overflow-y-auto lg:overscroll-contain',
					currentTopic && 'hidden',
				]}
			/>
		</div>
	</div>
	<Footer />
</Layout>
