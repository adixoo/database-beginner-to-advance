---
import DoodleFilters from '../components/DoodleFilters.astro';
import Footer from '../components/Footer.astro';
import Hero from '../components/Hero.astro';
import Navbar from '../components/Navbar.astro';
import PathChooser from '../components/PathChooser.astro';
import { SITE_DESCRIPTION, SITE_NAME, SITE_TAGLINE } from '../config/site';
import Layout from '../layouts/Layout.astro';
import { websiteJsonLd } from '../lib/seo';
---

<Layout
	title={`${SITE_NAME} · ${SITE_TAGLINE}`}
	description={SITE_DESCRIPTION}
	jsonLd={[websiteJsonLd(Astro.site!, SITE_DESCRIPTION)]}
>
	<div id="top">
		<Navbar />
		<main>
			<!-- The hero fills the first screen below the navbar row (about 92px tall) -->
			<div class="flex flex-col lg:min-h-[calc(100svh-92px)]">
				<Hero />
			</div>
			<PathChooser />
		</main>
	</div>
	<Footer />
	<DoodleFilters />
</Layout>
