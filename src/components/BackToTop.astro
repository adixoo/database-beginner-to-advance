---
// A round button fixed to the bottom-right corner that returns to the top of the page. Its ring
// fills as the page is scrolled, so it doubles as a reading-progress meter. It appears after
// the first screen; scripts/back-to-top.ts wires it up.
import { ArrowUp02Icon } from '@hugeicons/core-free-icons';
import { HugeiconsIcon } from '@hugeicons/react';
import { cornerButtonClass } from './corner-button';

// Ring geometry in the 48×48 button
const RADIUS = 22;
const CIRCUMFERENCE = 2 * Math.PI * RADIUS;
---

<button
	type="button"
	aria-label="Back to top"
	data-back-to-top
	inert
	class={cornerButtonClass('right')}
>
	<svg viewBox="0 0 48 48" class="absolute inset-0 size-full -rotate-90" aria-hidden="true">
		<circle cx="24" cy="24" r={RADIUS} fill="none" stroke="var(--color-gray-700)" stroke-width="2.5"
		></circle>
		<circle
			cx="24"
			cy="24"
			r={RADIUS}
			fill="none"
			stroke="currentColor"
			stroke-width="2.5"
			stroke-linecap="round"
			stroke-dasharray={CIRCUMFERENCE}
			stroke-dashoffset={CIRCUMFERENCE}
			data-back-to-top-ring></circle>
	</svg>
	<HugeiconsIcon icon={ArrowUp02Icon} size={20} strokeWidth={2} aria-hidden="true" />
</button>
