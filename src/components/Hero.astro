---
// The first screen: what this is and the two ways in on the left, a live mockup of the first
// lesson (making a table) on the right.
import { PATHS } from '../config/site';
import CanvasScene from './CanvasScene.astro';
import DoodleButton from './DoodleButton.astro';
---

<section
	class="grid flex-1 content-end gap-14 px-page pt-14 pb-24 lg:grid-cols-2 lg:content-center lg:items-end lg:gap-16 lg:pt-10 lg:pb-[clamp(48px,9svh,112px)]"
>
	<div>
		<!-- Desktop follows the taste skill's study (~8vw); phones fill the width (16.5vw), so the title reads big in a narrow screen -->
		<h1
			class="text-[clamp(44px,16.5vw,84px)] leading-[0.95] font-bold tracking-[-0.035em] text-ink sm:text-[clamp(84px,13vw,120px)] lg:text-[clamp(72px,8vw,136px)]"
			aria-label="Learn about databases"
		>
			<span class="block" data-reveal>Learn about</span>
			<span class="relative inline-block whitespace-nowrap" data-reveal style="--i: 1">
				databases
				<!-- Hand-drawn underline, drawn in once the word is in -->
				<CanvasScene
					scene="underline"
					class="pointer-events-none absolute inset-x-0 bottom-[-0.16em] w-full"
				/>
			</span>
		</h1>

		<p
			class="mt-10 max-w-[30ch] text-[clamp(20px,1.6vw,24px)] leading-snug text-ink-body"
			data-reveal
			style="--i: 2"
		>
			Start as a beginner, or go straight to advanced.
		</p>

		<div class="mt-9 flex flex-col gap-5 sm:flex-row" data-reveal style="--i: 3">
			<DoodleButton href={PATHS.beginner.href} class="sm:min-w-56">Start as beginner</DoodleButton>
			<DoodleButton href={PATHS.advanced.href} variant="secondary" class="sm:min-w-56">
				Start advanced
			</DoodleButton>
		</div>
	</div>

	<div data-reveal style="--i: 2">
		<CanvasScene
			scene="table"
			label="Animation: CREATE TABLE users is typed, then three users, asha.codes, ravi.clicks and meera.eats, are added as rows"
			class="w-full"
		/>
	</div>
</section>
