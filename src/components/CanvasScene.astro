---
// A Canvas 2D animation from src/scripts/canvas. With a `label` it is a picture with that
// accessible name; without one it is decoration and hidden from assistive tech. It plays once,
// when it first scrolls into view.
import type { HTMLAttributes } from 'astro/types';
import type { SceneName } from '../scripts/canvas/scenes';

interface Props extends Omit<HTMLAttributes<'canvas'>, 'class'> {
	scene: SceneName;
	label?: string;
	class?: string;
}

const { scene, label, class: className, ...rest } = Astro.props;
---

<canvas
	data-canvas-scene={scene}
	role={label ? 'img' : undefined}
	aria-label={label}
	aria-hidden={label ? undefined : 'true'}
	class:list={['block', className]}
	{...rest}>{label}</canvas
>

<script>
	import { SCENES, type SceneName } from '../scripts/canvas/scenes';
	import { mountScene } from '../scripts/canvas/stage';

	for (const canvas of document.querySelectorAll<HTMLCanvasElement>('[data-canvas-scene]')) {
		const scene = SCENES[canvas.dataset.canvasScene as SceneName];
		if (scene) mountScene(canvas, scene);
	}
</script>
