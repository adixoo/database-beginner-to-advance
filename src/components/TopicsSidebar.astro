---
import { PATHS, type Level } from '../config/site';
import { getTopics } from '../lib/topics';
import TopicList from './TopicList.astro';

interface Props {
	level: Level;
	currentTopic?: string;
	class?: string;
}

const { level, currentTopic, class: className } = Astro.props;
const topics = await getTopics(level);
const headingId = `${level}-topics`;
---

<!-- data-lenis-prevent: when the list is taller than the window it scrolls itself, not the page -->
<aside class={className} aria-labelledby={headingId} data-lenis-prevent>
	<h2 id={headingId} class="px-3 text-lg font-semibold">{PATHS[level].label} topics</h2>
	<TopicList topics={topics} currentTopic={currentTopic} class="mt-4" />
</aside>
