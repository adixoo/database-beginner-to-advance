---
import { PATHS, type Level } from '../config/site';
import { getTopics, topicHref } from '../lib/topics';

interface Props {
	level: Level;
	currentTopic?: string;
	class?: string;
}

const { level, currentTopic, class: className } = Astro.props;
const topics = await getTopics(level);
const headingId = `${level}-topics`;
---

<aside class:list={['rounded-[20px] bg-surface p-6', className]} aria-labelledby={headingId}>
	<h2 id={headingId} class="text-lg font-semibold">{PATHS[level].label} topics</h2>
	{
		topics.length ? (
			<ol class="mt-4 flex flex-col gap-1">
				{topics.map((topic) => (
					<li>
						<a
							href={topicHref(topic)}
							aria-current={topic.id === currentTopic ? 'page' : undefined}
							class="-mx-3 block rounded-xl px-3 py-2 text-base text-ink-soft transition-colors hover:bg-raised hover:text-ink aria-[current=page]:bg-raised aria-[current=page]:font-semibold aria-[current=page]:text-ink"
						>
							{topic.data.title}
						</a>
					</li>
				))}
			</ol>
		) : (
			<p class="mt-4 text-base text-ink-soft">No topics yet.</p>
		)
	}
</aside>
