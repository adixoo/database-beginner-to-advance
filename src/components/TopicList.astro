---
// A level's topics as links, in order, with the current one marked. Shared by the desktop
// sidebar (TopicsSidebar) and the phone menu (TopicsMenu).
import type { Topic } from '../lib/topics';
import { topicHref } from '../lib/topics';

interface Props {
	topics: Topic[];
	currentTopic?: string;
	class?: string;
}

const { topics, currentTopic, class: className } = Astro.props;
---

{
	topics.length ? (
		<ol class:list={['flex flex-col gap-1', className]}>
			{topics.map((topic) => (
				<li>
					<a
						href={topicHref(topic)}
						aria-current={topic.id === currentTopic ? 'page' : undefined}
						class="block rounded-xl px-3 py-2.5 text-base text-ink-soft transition-colors hover:bg-raised hover:text-ink aria-[current=page]:bg-raised aria-[current=page]:font-semibold aria-[current=page]:text-ink lg:py-2"
					>
						{topic.data.title}
					</a>
				</li>
			))}
		</ol>
	) : (
		<p class:list={['px-3 text-base text-ink-soft', className]}>No topics yet.</p>
	)
}
