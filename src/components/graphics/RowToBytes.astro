---
// One tuple written out as bytes: a row header (sky) that records each value's size and which
// are NULL, then the id (mint), then the body one byte per letter, with no gaps between them.
// Below ~540px it scrolls sideways.
import { BODY_END, CELL_HEIGHT, CHAR_X, HEADER_CELL, ID_CELL, ROW_BODY } from './row-bytes';
import RowBytesStrip from './RowBytesStrip.astro';

const TUPLE = `(1, '${ROW_BODY}')`;

const STRIP_Y = 150;
const LABEL_Y = STRIP_Y + CELL_HEIGHT + 22;
const bodyCentre = (CHAR_X + BODY_END) / 2;
---

<figure class="not-prose my-10">
	<div class="overflow-x-auto" role="region" aria-label="Row as bytes diagram" tabindex="0">
		<svg
			viewBox="0 0 640 240"
			class="w-full min-w-[540px]"
			role="img"
			aria-labelledby="rb-title rb-desc"
		>
			<title id="rb-title">A tuple is written as a row header followed by its values</title>
			<desc id="rb-desc">
				The tuple (1, 'Buy milk') becomes a run of bytes: first a small row header that records the
				size of each value and which values are NULL, then the id 1, then the body, one byte for
				each of the 8 letters B, u, y, space, m, i, l, k. The values sit one after another with no
				gaps.
			</desc>

			<g font-family="var(--font-sans)">
				<!-- The tuple -->
				<text x="14" y="26" font-size="17" font-weight="700" fill="var(--color-ink)">one tuple</text
				>
				<rect x="10" y="40" width="200" height="44" rx="10" fill="var(--color-raised)"></rect>
				<text
					x="110"
					y="68"
					text-anchor="middle"
					font-family="var(--font-mono)"
					font-size="16"
					fill="var(--color-ink)">{TUPLE}</text
				>

				<!-- As bytes -->
				<text x="14" y={STRIP_Y - 14} font-size="17" font-weight="700" fill="var(--color-ink)"
					>as bytes</text
				>
				<RowBytesStrip y={STRIP_Y} />

				<!-- What each part is -->
				<g font-size="13" fill="var(--color-ink-muted)" text-anchor="middle">
					<text x={HEADER_CELL.x + HEADER_CELL.width / 2} y={LABEL_Y}>sizes, NULLs</text>
					<text x={ID_CELL.x + ID_CELL.width / 2} y={LABEL_Y}>id</text>
					<text x={bodyCentre} y={LABEL_Y}>body: 8 bytes, one per letter</text>
				</g>
			</g>

			<!-- The tuple turns into bytes -->
			<g
				fill="none"
				stroke="var(--color-sky)"
				stroke-width="3"
				stroke-linecap="round"
				stroke-linejoin="round"
				aria-hidden="true"
			>
				<path d="M110 90 C 112 104, 108 118, 110 128"></path>
				<path d="M110 128 l-6.3 -9 M110 128 l6.3 -9"></path>
			</g>

			<!-- Annotation -->
			<g
				fill="none"
				stroke="var(--color-butter)"
				stroke-width="3"
				stroke-linecap="round"
				stroke-linejoin="round"
				aria-hidden="true"
			>
				<path d="M330 98 C 336 112, 340 126, 340 142"></path>
				<path d="M340 142 l-6.3 -9 M340 142 l6.3 -9"></path>
			</g>
			<g
				font-family="var(--font-hand)"
				font-size="22"
				font-weight="600"
				fill="var(--color-butter)"
				aria-hidden="true"
			>
				<text x="250" y="60">written one after another,</text>
				<text x="250" y="84">no gaps between them</text>
			</g>
		</svg>
	</div>
</figure>
