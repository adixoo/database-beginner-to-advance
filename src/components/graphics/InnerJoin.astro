---
// How INNER JOIN builds its result: each post's user_id is matched to a user's id (mint arrows),
// and every match becomes one result row holding all the post's columns followed by all the
// user's. meera.eats, with no posts, is left out (dimmed). Handwritten notes follow DESIGN.md
// (target, arrow, note). One SVG so the arrows stay locked to the rows at any width; below
// ~540px it scrolls sideways.
import JoinResult from './JoinResult.astro';
import SvgTable from './SvgTable.astro';
---

<figure class="not-prose my-10">
	<div class="overflow-x-auto" role="region" aria-label="INNER JOIN diagram" tabindex="0">
		<svg
			viewBox="0 0 690 566"
			class="w-full min-w-[540px]"
			role="img"
			aria-labelledby="ij-title ij-desc"
		>
			<title id="ij-title">INNER JOIN glues each post to its user and keeps only the matches</title>
			<desc id="ij-desc">
				Post 101 has user_id 1 and matches asha.codes. Post 102 has user_id 2 and matches
				ravi.clicks. Post 103 has user_id 1 and matches asha.codes. meera.eats has no posts, so it
				has no match and is left out. Each match becomes one result row with every column of both
				tables: id, user_id and caption from posts, then id, username and name from users. 101, 1,
				Sunset at the beach, 1, asha.codes, Asha. 102, 2, First latte art, 2, ravi.clicks, Ravi.
				103, 1, Weekend trek, 1, asha.codes, Asha.
			</desc>

			<SvgTable
				name="posts"
				x={10}
				y={40}
				width={330}
				columns={[
					{ label: 'id', x: 54, anchor: 'end' },
					{ label: 'user_id', x: 124, anchor: 'end', key: true },
					{ label: 'caption', x: 150, anchor: 'start' },
				]}
				rows={[
					['101', '1', 'Sunset at the beach'],
					['102', '2', 'First latte art'],
					['103', '1', 'Weekend trek'],
				]}
				keyTint={{ x: 64, width: 66 }}
			/>
			<SvgTable
				name="users"
				x={440}
				y={40}
				width={230}
				columns={[
					{ label: 'id', x: 474, anchor: 'end', key: true },
					{ label: 'username', x: 494, anchor: 'start' },
					{ label: 'name', x: 600, anchor: 'start' },
				]}
				rows={[
					['1', 'asha.codes', 'Asha'],
					['2', 'ravi.clicks', 'Ravi'],
					['3', 'meera.eats', 'Meera'],
				]}
				keyTint={{ x: 446, width: 40 }}
			/>
			<!-- meera.eats has no match: dim the row -->
			<rect x="444" y="178" width="222" height="40" rx="8" fill="var(--color-canvas)" opacity="0.6"
			></rect>

			<!-- The matches: each post's user_id to the user with that id -->
			<g
				fill="none"
				stroke="var(--color-mint)"
				stroke-width="3"
				stroke-linecap="round"
				stroke-linejoin="round"
				aria-hidden="true"
			>
				<path d="M344 108 C 372 102, 404 102, 432 106"></path>
				<path d="M432 106 l-8.1 -7.5 M432 106 l-9.8 5"></path>
				<path d="M344 152 C 372 146, 404 146, 432 150"></path>
				<path d="M432 150 l-8.1 -7.5 M432 150 l-9.8 5"></path>
				<path d="M344 196 C 384 194, 400 128, 432 116"></path>
				<path d="M432 116 l-10.7 -2.7 M432 116 l-6.2 9.1"></path>
			</g>

			<JoinResult
				y={244}
				rows={[
					['101', '1', 'Sunset at the beach', '1', 'asha.codes', 'Asha'],
					['102', '2', 'First latte art', '2', 'ravi.clicks', 'Ravi'],
					['103', '1', 'Weekend trek', '1', 'asha.codes', 'Asha'],
				]}
			/>

			<!-- Annotations: arrows end 12-16px short of their targets -->
			<g
				fill="none"
				stroke="var(--color-butter)"
				stroke-width="3"
				stroke-linecap="round"
				stroke-linejoin="round"
				aria-hidden="true"
			>
				<path d="M549 258 C 551 248, 549 240, 547 234"></path>
				<path d="M547 234 l-6.3 9 M547 234 l6.3 9"></path>
				<path d="M568 440 C 562 434, 558 432, 552 432"></path>
				<path d="M552 432 l9 6.3 M552 432 l9 -6.3"></path>
			</g>
			<g
				font-family="var(--font-hand)"
				font-size="24"
				font-weight="600"
				fill="var(--color-butter)"
				aria-hidden="true"
			>
				<text x="555" y="280" text-anchor="middle">no posts,</text>
				<text x="555" y="304" text-anchor="middle">so left out</text>
				<text x="574" y="448">one row</text>
				<text x="574" y="472">per match</text>
			</g>
		</svg>
	</div>
</figure>
