---
// SQLite overflow pages: a row too big for its page keeps its start in the table page, and the
// rest goes to a chain of overflow pages, each pointing at the next (sky). Every part of the
// big row is peach. Below ~520px it scrolls sideways.

interface Box {
	title: string;
	x: number;
	width: number;
}

const BOX_Y = 50;
const BOX_HEIGHT = 120;
const TABLE_PAGE: Box = { title: 'table page', x: 10, width: 190 };
const OVERFLOW_PAGES: (Box & { part: string })[] = [
	{ title: 'overflow page', x: 250, width: 170, part: 'row 4: next 4 KB' },
	{ title: 'overflow page', x: 460, width: 170, part: 'row 4: the rest' },
];
const INSET = 12;
---

<figure class="not-prose my-10">
	<div class="overflow-x-auto" role="region" aria-label="Overflow pages diagram" tabindex="0">
		<svg
			viewBox="0 0 640 240"
			class="w-full min-w-[520px]"
			role="img"
			aria-labelledby="op-title op-desc"
		>
			<title id="op-title">A row too big for its page continues on overflow pages</title>
			<desc id="op-desc">
				In SQLite, the table page holds a header, rows 1 to 3 and the start of row 4, a
				10,000-character note. The rest of row 4 goes to an overflow page, which points at a second
				overflow page holding the end. One long note is spread over three pages.
			</desc>

			<g font-family="var(--font-sans)">
				{
					[TABLE_PAGE, ...OVERFLOW_PAGES].map((box) => (
						<g>
							<text
								x={box.x + 4}
								y={BOX_Y - 14}
								font-size="17"
								font-weight="700"
								fill="var(--color-ink)"
							>
								{box.title}
							</text>
							<rect
								x={box.x}
								y={BOX_Y}
								width={box.width}
								height={BOX_HEIGHT}
								rx="14"
								fill="var(--color-surface)"
							/>
						</g>
					))
				}

				<!-- Table page: header, small rows, then the start of the big row -->
				<rect
					x={TABLE_PAGE.x + INSET}
					y={BOX_Y + INSET}
					width={TABLE_PAGE.width - 2 * INSET}
					height="24"
					rx="6"
					fill="var(--color-raised)"></rect>
				<text x={TABLE_PAGE.x + 24} y={BOX_Y + 29} font-size="12" fill="var(--color-ink-muted)"
					>header</text
				>
				<rect
					x={TABLE_PAGE.x + INSET}
					y={BOX_Y + 44}
					width={TABLE_PAGE.width - 2 * INSET}
					height="26"
					rx="6"
					fill="var(--color-raised)"></rect>
				<text x={TABLE_PAGE.x + 24} y={BOX_Y + 62} font-size="13" fill="var(--color-ink-muted)"
					>rows 1–3</text
				>
				<rect
					x={TABLE_PAGE.x + INSET}
					y={BOX_Y + 78}
					width={TABLE_PAGE.width - 2 * INSET}
					height="30"
					rx="6"
					fill="var(--color-peach)"
					fill-opacity="0.1"
					stroke="var(--color-peach)"
					stroke-width="2"></rect>
				<text
					x={TABLE_PAGE.x + 24}
					y={BOX_Y + 98}
					font-size="14"
					font-weight="600"
					fill="var(--color-ink)">row 4: the start</text
				>

				<!-- Overflow pages: the rest of the big row -->
				{
					OVERFLOW_PAGES.map((box) => (
						<g>
							<rect
								x={box.x + INSET}
								y={BOX_Y + INSET}
								width={box.width - 2 * INSET}
								height={BOX_HEIGHT - 2 * INSET}
								rx="8"
								fill="var(--color-peach)"
								fill-opacity="0.1"
								stroke="var(--color-peach)"
								stroke-width="2"
							/>
							<text
								x={box.x + box.width / 2}
								y={BOX_Y + BOX_HEIGHT / 2 + 5}
								text-anchor="middle"
								font-size="14"
								font-weight="600"
								fill="var(--color-ink)"
							>
								{box.part}
							</text>
						</g>
					))
				}
			</g>

			<!-- The chain: each part points at the next page -->
			<g
				fill="none"
				stroke="var(--color-sky)"
				stroke-width="3"
				stroke-linecap="round"
				stroke-linejoin="round"
				aria-hidden="true"
			>
				<path d="M190 143 C 222 143, 222 110, 246 110"></path>
				<path d="M246 110 l-9 -6.3 M246 110 l-9 6.3"></path>
				<path d="M410 110 L 456 110"></path>
				<path d="M456 110 l-9 -6.3 M456 110 l-9 6.3"></path>
			</g>

			<!-- Annotation -->
			<g
				fill="none"
				stroke="var(--color-butter)"
				stroke-width="3"
				stroke-linecap="round"
				stroke-linejoin="round"
				aria-hidden="true"
			>
				<path d="M335 202 C 337 194, 334 186, 335 178"></path>
				<path d="M335 178 l-6.3 9 M335 178 l6.3 9"></path>
			</g>
			<text
				x="335"
				y="228"
				text-anchor="middle"
				font-family="var(--font-hand)"
				font-size="22"
				font-weight="600"
				fill="var(--color-butter)"
				aria-hidden="true">one long note, spread over three pages</text
			>
		</svg>
	</div>
</figure>
