---
// Why pages exist: asking for one 40-byte row still makes the disk read the whole 4 KB block
// around it. So the database fills each block with rows (row 2, the one asked for, in peach)
// and one read brings back about 100 of them. Below ~520px it scrolls sideways.

const BLOCK = { x: 250, y: 44, width: 380, height: 200 };
const BAR_X = 266;
const BAR_WIDTH = 348;
const BAR_TOP = 60;
const BAR_HEIGHT = 24;
const BAR_GAP = 8;
const ROW_COUNT = 5;
const WANTED_ROW = 2;

const bars = Array.from({ length: ROW_COUNT }, (_, index) => ({
	row: index + 1,
	y: BAR_TOP + index * (BAR_HEIGHT + BAR_GAP),
}));
---

<figure class="not-prose my-10">
	<div class="overflow-x-auto" role="region" aria-label="Disk block read diagram" tabindex="0">
		<svg
			viewBox="0 0 640 310"
			class="w-full min-w-[520px]"
			role="img"
			aria-labelledby="dbr-title dbr-desc"
		>
			<title id="dbr-title">Asking for one row still reads a whole block</title>
			<desc id="dbr-desc">
				You ask for one row of 40 bytes. The disk and the operating system never read less than a
				whole block, so they read 4 KB anyway. If the block is packed with rows, that one read
				brings back about 100 rows, including the one you wanted.
			</desc>

			<g font-family="var(--font-sans)">
				<!-- What you ask for -->
				<text x="14" y="30" font-size="17" font-weight="700" fill="var(--color-ink)"
					>you ask for</text
				>
				<rect x="10" y="44" width="170" height="48" rx="10" fill="var(--color-raised)"></rect>
				<text
					x="95"
					y="74"
					text-anchor="middle"
					font-family="var(--font-mono)"
					font-size="15"
					fill="var(--color-ink)">row 2 · 40 bytes</text
				>
				<text x="14" y="120" font-size="13" fill="var(--color-ink-muted)">
					<tspan x="14">the OS never reads</tspan>
					<tspan x="14" dy="18">less than one block</tspan>
				</text>

				<!-- What the disk reads -->
				<text x={BLOCK.x + 4} y="30" font-size="17" font-weight="700" fill="var(--color-ink)"
					>the disk reads a whole 4 KB block</text
				>
				<rect
					x={BLOCK.x}
					y={BLOCK.y}
					width={BLOCK.width}
					height={BLOCK.height}
					rx="14"
					fill="var(--color-surface)"></rect>
				{
					bars.map((bar) => {
						const isWanted = bar.row === WANTED_ROW;
						return (
							<g>
								<rect
									x={BAR_X}
									y={bar.y}
									width={BAR_WIDTH}
									height={BAR_HEIGHT}
									rx="6"
									fill={isWanted ? 'var(--color-peach)' : 'var(--color-raised)'}
									fill-opacity={isWanted ? 0.1 : 1}
									stroke={isWanted ? 'var(--color-peach)' : 'none'}
									stroke-width="2"
								/>
								<text
									x={BAR_X + 12}
									y={bar.y + 17}
									font-size="13"
									font-weight={isWanted ? 600 : 400}
									fill={isWanted ? 'var(--color-ink)' : 'var(--color-ink-muted)'}
								>
									row {bar.row}
								</text>
							</g>
						);
					})
				}
				<text x={BAR_X + 12} y="230" font-size="13" fill="var(--color-ink-muted)"
					>… and so on, about 100 rows of 40 bytes</text
				>
			</g>

			<!-- The request goes to the disk -->
			<g
				fill="none"
				stroke="var(--color-sky)"
				stroke-width="3"
				stroke-linecap="round"
				stroke-linejoin="round"
				aria-hidden="true"
			>
				<path d="M184 68 C 206 68, 224 72, 244 72"></path>
				<path d="M244 72 l-9 -6.3 M244 72 l-9 6.3"></path>
			</g>

			<!-- Annotation -->
			<g
				fill="none"
				stroke="var(--color-butter)"
				stroke-width="3"
				stroke-linecap="round"
				stroke-linejoin="round"
				aria-hidden="true"
			>
				<path d="M440 274 C 442 266, 438 258, 440 250"></path>
				<path d="M440 250 l-6.3 9 M440 250 l6.3 9"></path>
			</g>
			<text
				x="440"
				y="298"
				text-anchor="middle"
				font-family="var(--font-hand)"
				font-size="22"
				font-weight="600"
				fill="var(--color-butter)"
				aria-hidden="true">one read brings back ~100 rows, not 1</text
			>
		</svg>
	</div>
</figure>
