---
// What a row header holds: the row (1, 'Buy milk') as bytes, with the header opened up below it.
// The header notes each value's size (id 1 byte in mint, body 8 bytes in peach, matching the
// brackets over the values) and which values are NULL. Below ~540px it scrolls sideways.
import { BODY_END, CELL_HEIGHT, CHAR_X, HEADER_CELL, ID_CELL } from './row-bytes';
import RowBytesStrip from './RowBytesStrip.astro';

const STRIP_Y = 54;
const BRACKET_TOP = 38;
const BRACKET_BOTTOM = 46;

const ZOOM = { x: 10, y: 140, width: 440, height: 64 };
const ENTRY_Y = ZOOM.y + 12;
const ENTRY_HEIGHT = 40;

const ENTRIES = [
	{ text: 'id: 1 byte', x: 22, width: 130, tone: 'var(--color-mint)' },
	{ text: 'body: 8 bytes', x: 160, width: 140, tone: 'var(--color-peach)' },
	{ text: 'no NULLs', x: 308, width: 130 },
];
---

<figure class="not-prose my-10">
	<div class="overflow-x-auto" role="region" aria-label="Row header diagram" tabindex="0">
		<svg
			viewBox="0 0 640 220"
			class="w-full min-w-[540px]"
			role="img"
			aria-labelledby="rh-title rh-desc"
		>
			<title id="rh-title">The row header says how big each value is and which are NULL</title>
			<desc id="rh-desc">
				The row (1, 'Buy milk') as bytes: a header, then the id 1, which takes 1 byte, then the body
				Buy milk, which takes 8 bytes. Opened up, the header says: id is 1 byte, body is 8 bytes,
				and no value is NULL. That is how the database knows where each value ends.
			</desc>

			<g font-family="var(--font-sans)">
				<!-- How many bytes each value takes -->
				<g font-family="var(--font-mono)" font-size="13" text-anchor="middle">
					<text x={ID_CELL.x + ID_CELL.width / 2} y="30" fill="var(--color-mint)">1 byte</text>
					<text x={(CHAR_X + BODY_END) / 2} y="30" fill="var(--color-peach)">8 bytes</text>
				</g>
				<g fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
					<path
						d={`M${ID_CELL.x + 2} ${BRACKET_BOTTOM} V${BRACKET_TOP} H${ID_CELL.x + ID_CELL.width - 2} V${BRACKET_BOTTOM}`}
						stroke="var(--color-mint)"></path>
					<path
						d={`M${CHAR_X + 2} ${BRACKET_BOTTOM} V${BRACKET_TOP} H${BODY_END - 2} V${BRACKET_BOTTOM}`}
						stroke="var(--color-peach)"></path>
				</g>

				<!-- The row as bytes -->
				<RowBytesStrip y={STRIP_Y} />

				<!-- The header, opened up -->
				<g fill="none" stroke="var(--color-gray-600)" stroke-width="1.5" stroke-dasharray="4 5">
					<line x1={HEADER_CELL.x} y1={STRIP_Y + CELL_HEIGHT} x2={ZOOM.x} y2={ZOOM.y}></line>
					<line
						x1={HEADER_CELL.x + HEADER_CELL.width}
						y1={STRIP_Y + CELL_HEIGHT}
						x2={ZOOM.x + ZOOM.width}
						y2={ZOOM.y}></line>
				</g>
				<rect
					x={ZOOM.x}
					y={ZOOM.y}
					width={ZOOM.width}
					height={ZOOM.height}
					rx="12"
					fill="var(--color-sky)"
					fill-opacity="0.14"
					stroke="var(--color-sky)"
					stroke-width="2"></rect>
				{
					ENTRIES.map((entry) => (
						<g>
							<rect
								x={entry.x}
								y={ENTRY_Y}
								width={entry.width}
								height={ENTRY_HEIGHT}
								rx="8"
								fill={entry.tone ?? 'var(--color-raised)'}
								fill-opacity={entry.tone ? 0.14 : 1}
								stroke={entry.tone ?? 'none'}
								stroke-width="2"
							/>
							<text
								x={entry.x + entry.width / 2}
								y={ENTRY_Y + 25}
								text-anchor="middle"
								font-family="var(--font-mono)"
								font-size="14"
								fill="var(--color-ink)"
							>
								{entry.text}
							</text>
						</g>
					))
				}
			</g>

			<!-- Annotation -->
			<g
				fill="none"
				stroke="var(--color-butter)"
				stroke-width="3"
				stroke-linecap="round"
				stroke-linejoin="round"
				aria-hidden="true"
			>
				<path d="M488 178 C 478 176, 468 174, 458 172"></path>
				<path d="M458 172 l9 -6.3 M458 172 l9 6.3"></path>
			</g>
			<g
				font-family="var(--font-hand)"
				font-size="20"
				font-weight="600"
				fill="var(--color-butter)"
				aria-hidden="true"
			>
				<text x="494" y="170">says where each</text>
				<text x="494" y="194">value ends</text>
			</g>
		</svg>
	</div>
</figure>
