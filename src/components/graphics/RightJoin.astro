---
// How RIGHT JOIN builds its result: every row of the second table (users) is kept. Posts are
// matched to their users (mint arrows); meera.eats has no posts but stays in (peach), and the
// result fills the posts columns of that row with NULL. Handwritten notes follow DESIGN.md
// (target, arrow, note). One SVG so the arrows stay locked to the rows at any width; below
// ~540px it scrolls sideways.
import JoinResult from './JoinResult.astro';
import {
	JOIN_POSTS_COLUMNS,
	JOIN_POSTS_ROWS,
	JOIN_USERS_COLUMNS,
	JOIN_USERS_ROWS,
} from './join-tables';
import SvgTable from './SvgTable.astro';
---

<figure class="not-prose my-10">
	<div class="overflow-x-auto" role="region" aria-label="RIGHT JOIN diagram" tabindex="0">
		<svg
			viewBox="0 0 690 610"
			class="w-full min-w-[540px]"
			role="img"
			aria-labelledby="rj-title rj-desc"
		>
			<title id="rj-title">RIGHT JOIN keeps every user, even one with no posts</title>
			<desc id="rj-desc">
				Post 101 matches asha.codes, post 102 matches ravi.clicks and post 103 matches asha.codes.
				meera.eats has no posts but is still kept, because users is the table after RIGHT JOIN. The
				result has four rows: the three matches, then a row for meera.eats, Meera, whose id, user_id
				and caption from posts are all NULL.
			</desc>

			<SvgTable
				name="posts"
				x={10}
				y={40}
				width={330}
				columns={JOIN_POSTS_COLUMNS}
				rows={JOIN_POSTS_ROWS}
				keyTint={{ x: 64, width: 66 }}
			/>
			<SvgTable
				name="users"
				x={440}
				y={40}
				width={230}
				columns={JOIN_USERS_COLUMNS}
				rows={JOIN_USERS_ROWS}
				keyTint={{ x: 446, width: 40 }}
				linkedRows={[2]}
			/>

			<!-- The matches: each post's user_id to the user with that id -->
			<g
				fill="none"
				stroke="var(--color-mint)"
				stroke-width="3"
				stroke-linecap="round"
				stroke-linejoin="round"
				aria-hidden="true"
			>
				<path d="M344 108 C 372 102, 404 102, 432 106"></path>
				<path d="M432 106 l-8.1 -7.5 M432 106 l-9.8 5"></path>
				<path d="M344 152 C 372 146, 404 146, 432 150"></path>
				<path d="M432 150 l-8.1 -7.5 M432 150 l-9.8 5"></path>
				<path d="M344 196 C 384 194, 400 128, 432 116"></path>
				<path d="M432 116 l-10.7 -2.7 M432 116 l-6.2 9.1"></path>
			</g>

			<JoinResult
				y={244}
				rows={[
					['101', '1', 'Sunset at the beach', '1', 'asha.codes', 'Asha'],
					['102', '2', 'First latte art', '2', 'ravi.clicks', 'Ravi'],
					['103', '1', 'Weekend trek', '1', 'asha.codes', 'Asha'],
					['NULL', 'NULL', 'NULL', '3', 'meera.eats', 'Meera'],
				]}
				linkedRows={[3]}
			/>

			<!-- Annotations: arrows end 12-16px short of their targets -->
			<g
				fill="none"
				stroke="var(--color-butter)"
				stroke-width="3"
				stroke-linecap="round"
				stroke-linejoin="round"
				aria-hidden="true"
			>
				<path d="M549 258 C 551 248, 549 240, 547 234"></path>
				<path d="M547 234 l-6.3 9 M547 234 l6.3 9"></path>
				<path d="M568 522 C 562 520, 558 520, 552 520"></path>
				<path d="M552 520 l9 6.3 M552 520 l9 -6.3"></path>
			</g>
			<g
				font-family="var(--font-hand)"
				font-size="24"
				font-weight="600"
				fill="var(--color-butter)"
				aria-hidden="true"
			>
				<text x="555" y="280" text-anchor="middle">no posts,</text>
				<text x="555" y="304" text-anchor="middle">still kept</text>
				<text x="574" y="528">no post,</text>
				<text x="574" y="552">so NULL</text>
			</g>
		</svg>
	</div>
</figure>
